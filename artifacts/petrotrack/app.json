{
  "expo": {
    "name": "Petrotrack",
    "slug": "petrotrack",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petrotrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.petrotrack",
      "buildNumber": "54",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Petrotrack uses Face ID to let you sign in quickly and securely.",
        "UIBackgroundModes": [
          "voip"
        ]
      }
    },
    "android": {
      "package": "petrotrack.replit.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://petrotrack.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-document-picker"
      ,"expo-notifications"
      ,[
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableCamera": true,
          "enableMicrophone": true,
          "enableScreenShare": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "075f5965-7a4a-41dc-8700-f956b13b942f"
      }
    },
    "owner": "chrismoil"
  }
}
